cat <<'YAML' | kubectl apply -f -
apiVersion: batch/v1
kind: Job
metadata:
  name: gw-train-tft
  labels:
    app: gw-train
spec:
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app: gw-train
    spec:
      restartPolicy: Never
      nodeSelector:
        gpu: a100
      volumes:
      - name: gw-pred-rwx
        persistentVolumeClaim:
          claimName: gw-pred-rwx
      - name: dshm
        emptyDir:
          medium: Memory
          sizeLimit: "16Gi"
      containers:
      - name: train
        image: row56/gw-pred:py312-cu124
        imagePullPolicy: Always
        resources:
          requests:
            cpu: "16"
            memory: 64Gi
            nvidia.com/gpu: 1
          limits:
            memory: 64Gi
            nvidia.com/gpu: 1
        env:
        - name: WANDB_API_KEY
          valueFrom:
            secretKeyRef:
              name: wandb-api
              key: api-key
        - name: WANDB_PROJECT
          value: "gw-pred"
        - name: WANDB_ENTITY
          value: "gw-pred"
        - name: WANDB_DIR
          value: "/storage/wandb"
        - name: PYTHONUNBUFFERED
          value: "1"

        volumeMounts:
        - name: gw-pred-rwx
          mountPath: /storage
        - name: dshm
          mountPath: /dev/shm
        command: ["bash","-lc"]
        args:
        - >
          source /storage/venv/bin/activate &&
          cd /storage/gwl-interpolation &&
          python src/scripts/separate/temporal/kunz_darts/tft_train.py &&
          python src/scripts/separate/temporal/kunz_darts/tft_eval.py
YAML